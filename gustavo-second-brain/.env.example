# Copy this file to .env and fill in real values. Never commit .env.

# --- YouTube ---
# YouTube Data API v3 key (Google Cloud Console project, API key only -- no OAuth needed for public data)
YOUTUBE_API_KEY=

# The two Gustavo channels (URL or @handle or channel ID -- any form works)
YOUTUBE_CHANNEL_1_URL=
YOUTUBE_CHANNEL_2_URL=

# --- Google Drive (source of truth + destination) ---
GOOGLE_DRIVE_SOURCE_FOLDER_ID=1kggFa7toDnOvD3WCJf2tI_iaNDEwehr6
GOOGLE_DRIVE_SECOND_BRAIN_FOLDER_ID=1OCPpwwGtRmIgAXfhFNmJ9WL9uBSP-OXU

# --- YouTube OAuth (credentials downloaded from Google Cloud Console) ---
YOUTUBE_OAUTH_CLIENT_FILE=credentials/youtube_oauth_client.json
YOUTUBE_OAUTH_TOKEN_FILE=tokens/youtube_gustavo.json

# --- YouTube OAuth remoto (cuando quien autoriza no esta en esta maquina) ---
# Tipo de cliente "Web application" en Google Cloud Console.
YOUTUBE_OAUTH_WEB_CLIENT_FILE=credentials/youtube_oauth_web.json
# URL publica del Cloudflare Quick Tunnel + /oauth2/callback. Cambia cada vez
# que se reinicia el tunel -- debe coincidir con el redirect URI autorizado.
YOUTUBE_OAUTH_REDIRECT_URI=

# --- Drive OAuth (para sync_drive.py -- credenciales separadas de YouTube,
# NUNCA reutiliza ni toca tokens/youtube_gustavo*.json). Tipo de cliente
# "Desktop app" en Google Cloud Console (distinto del "Web application" de
# arriba). Requiere la Google Drive API habilitada en el mismo proyecto.
GOOGLE_DRIVE_OAUTH_CLIENT_FILE=credentials/google_drive_oauth_client.json
GOOGLE_DRIVE_OAUTH_TOKEN_FILE=tokens/google_drive_hilario.json

# --- Whisper (local transcription fallback) ---
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Embeddings (local semantic search) ---
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2

# --- n8n (self-hosted, Docker) ---
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
