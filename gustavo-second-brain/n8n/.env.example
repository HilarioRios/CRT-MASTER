# Copy this file to .env (same folder) and fill in real values.
# .env is already covered by the project's root .gitignore (pattern ".env") -- never commit it.

# Used by n8n to encrypt stored credentials. Generate once with:
#   openssl rand -hex 32
# Keep it stable -- rotating it makes previously saved credentials unreadable.
N8N_ENCRYPTION_KEY=changeme

# NOTE: N8N_BASIC_AUTH_ACTIVE/_USER/_PASSWORD are no-ops on current n8n versions
# (replaced by n8n's own owner-account login, created the first time you open the UI).
# Access control for this local install is: (1) the port is bound to 127.0.0.1 only,
# and (2) the owner account you create on first login at http://localhost:5678.
