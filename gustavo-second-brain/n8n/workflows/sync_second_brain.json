{
  "id": "gustavo-second-brain-sync-ready",
  "name": "Gustavo Second Brain — Sync Ready Sources",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "b2b2b2b2-0001-4000-8000-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8731/health",
        "options": {}
      },
      "id": "b2b2b2b2-0002-4000-8000-000000000002",
      "name": "GET /health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c1", "leftValue": "={{$json.ok}}", "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2b2b2b2-0003-4000-8000-000000000003",
      "name": "IF health OK",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8731/jobs/sync-ready",
        "options": {}
      },
      "id": "b2b2b2b2-0004-4000-8000-000000000004",
      "name": "POST /jobs/sync-ready",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, -80]
    },
    {
      "parameters": {
        "amount": 3
      },
      "id": "b2b2b2b2-0005-4000-8000-000000000005",
      "name": "Wait before poll",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [880, -80]
    },
    {
      "parameters": {
        "url": "=http://host.docker.internal:8731/jobs/{{$('POST /jobs/sync-ready').item.json.job_id}}",
        "options": {}
      },
      "id": "b2b2b2b2-0006-4000-8000-000000000006",
      "name": "GET /jobs/{job_id}",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, -80]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c2", "leftValue": "={{$json.status}}", "rightValue": "QUEUED,RUNNING",
              "operator": { "type": "string", "operation": "regex" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2b2b2b2-0007-4000-8000-000000000007",
      "name": "IF still running",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1320, -80]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c3", "leftValue": "={{$json.status}}", "rightValue": "FAILED",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2b2b2b2-0008-4000-8000-000000000008",
      "name": "IF failed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1540, -40]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "summary", "type": "string",
              "value": "=OK job_id={{$json.job_id}} status={{$json.status}} FOUND_READY={{$json.metrics.FOUND_READY}} UPLOADED={{$json.metrics.UPLOADED}} SKIPPED_ALREADY_SYNCED={{$json.metrics.SKIPPED_ALREADY_SYNCED}} FAILED={{$json.metrics.FAILED}} PENDING_MEMBERS_ONLY={{$json.metrics.PENDING_MEMBERS_ONLY}}" }
          ]
        },
        "options": {}
      },
      "id": "b2b2b2b2-0009-4000-8000-000000000009",
      "name": "Log summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1760, -120]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a2", "name": "error_summary", "type": "string",
              "value": "=FAILED job_id={{$json.job_id}} metrics={{JSON.stringify($json.metrics)}}" }
          ]
        },
        "options": {}
      },
      "id": "b2b2b2b2-0010-4000-8000-000000000010",
      "name": "Log error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1760, 40]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a3", "name": "health_error", "type": "string",
              "value": "=orchestrator /health returned ok=false: {{JSON.stringify($json)}}" }
          ]
        },
        "options": {}
      },
      "id": "b2b2b2b2-0011-4000-8000-000000000011",
      "name": "Log health error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [660, 120]
    }
  ],
  "connections": {
    "Manual Trigger": { "main": [[{ "node": "GET /health", "type": "main", "index": 0 }]] },
    "GET /health": { "main": [[{ "node": "IF health OK", "type": "main", "index": 0 }]] },
    "IF health OK": {
      "main": [
        [{ "node": "POST /jobs/sync-ready", "type": "main", "index": 0 }],
        [{ "node": "Log health error", "type": "main", "index": 0 }]
      ]
    },
    "POST /jobs/sync-ready": { "main": [[{ "node": "Wait before poll", "type": "main", "index": 0 }]] },
    "Wait before poll": { "main": [[{ "node": "GET /jobs/{job_id}", "type": "main", "index": 0 }]] },
    "GET /jobs/{job_id}": { "main": [[{ "node": "IF still running", "type": "main", "index": 0 }]] },
    "IF still running": {
      "main": [
        [{ "node": "Wait before poll", "type": "main", "index": 0 }],
        [{ "node": "IF failed", "type": "main", "index": 0 }]
      ]
    },
    "IF failed": {
      "main": [
        [{ "node": "Log error", "type": "main", "index": 0 }],
        [{ "node": "Log summary", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
