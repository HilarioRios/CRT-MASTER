# Variables del SERVIDOR (Vercel → Settings → Environment Variables, o Netlify).
# No llevan el prefijo VITE_, así que nunca llegan al navegador.
# No subir un .env con valores reales al repositorio.

# Códigos que se reparten por WhatsApp, separados por coma.
# Usar códigos largos y aleatorios (12+ caracteres).
UNLOCK_CODES=

# Clase 7 (bloqueada entera): URL compartida de Loom y link de su PDF
# (CRT MASTER, capítulos 9, 10 y 11).
RESOURCE_VIDEO_CRT_C7=
RESOURCE_URL_CRT_C7=
